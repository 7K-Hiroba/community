{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/7K-Hiroba/community/blob/main/registry/apps.schema.json",
  "title": "Hiroba application identity registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "apps"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository",
          "maintainers",
          "status",
          "dashboardUidPrefix",
          "grafanaFolderSegment"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "repository": {
            "type": "string",
            "pattern": "^https://github\\.com/7K-Hiroba/.+$"
          },
          "maintainers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^@7K-Hiroba/[a-z][a-z0-9-]{0,62}$"
            }
          },
          "status": {
            "enum": ["reserved", "active", "deprecated"]
          },
          "dashboardUidPrefix": {
            "type": "string",
            "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?-$"
          },
          "grafanaFolderSegment": {
            "type": "string",
            "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "replacedBy": {
            "type": "string",
            "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "migratedFrom": {
            "type": "string",
            "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
          }
        }
      }
    }
  }
}
